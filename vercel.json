{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/ai/insight",
      "destination": "/api/ai/insight"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
